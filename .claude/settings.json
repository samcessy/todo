{
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(composer test:*)",
      "Bash(composer audit:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run types:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm audit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(php artisan migrate:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(php artisan db:wipe:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-on-edit.sh" }
        ]
      }
    ]
  }
}
